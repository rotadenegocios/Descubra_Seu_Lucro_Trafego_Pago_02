# Banco PostgreSQL/Neon usado para armazenar os leads do formulario.
DATABASE_URL=

# Banco exclusivo desta pagina dentro do projeto Neon conectado.
# Esta pagina usa o mesmo productId ("descubra-seu-lucro") da pagina 01, entao ela
# pode gravar no mesmo banco. As duas se distinguem por page_url e utm.
LEADS_DATABASE_NAME=leads_descubra_seu_lucro

# Opcional: use uma URL completa exclusiva em vez de DATABASE_URL + nome acima.
LEADS_DATABASE_URL=

# Envio do lead para o CRM pelo n8n (fluxo LEAD DO SITE -> CRM v2).
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=

# --- Rastreio (cliente: entra no bundle, use apenas IDs publicos) ---
VITE_TRACKING_ENABLED=true
VITE_SITE_ID=descubra-seu-lucro
VITE_GA4_MEASUREMENT_ID=G-434Q7GE2NZ
# Container do GTM. Vazio desliga.
VITE_GTM_ID=
# Um ou mais IDs separados por virgula.
VITE_META_PIXEL_ID=2074399583036288,1336189881164076
VITE_TRACKING_DEBUG=false

# --- Rastreio (servidor: nunca use o prefixo VITE_) ---
# Os mesmos numeros do VITE_META_PIXEL_ID, na mesma ordem.
META_DATASET_ID=2074399583036288,1336189881164076
META_CAPI_ACCESS_TOKEN=
# Preencher apenas durante a validacao no Events Manager.
META_TEST_EVENT_CODE=
# String aleatoria usada no hash do external_id e na pseudonimizacao do log.
TRACKING_SALT=
# Sufixos de origem aceitos pelo /api/track, separados por virgula. Vazio usa o padrao.
TRACKING_ALLOWED_ORIGINS=

# --- Log first-party (legitimo interesse, roda sem depender do aceite) ---
TRACKING_LOG_ENABLED=false
# Opcionais: por padrao o log usa o mesmo banco do /api/leads.
TRACKING_DATABASE_URL=
TRACKING_DATABASE_NAME=
